{
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "name": {
      "type": "string",
      "maxLength": 120
    },
    "type": {
      "$ref": "#/$defs/SourceType"
    },
    "config": {
      "$ref": "#/$defs/SourceConfig"
    },
    "mapping": {
      "$ref": "#/$defs/FieldMapping"
    },
    "refreshMinutes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1440
    }
  },
  "required": [
    "id",
    "name",
    "type",
    "config",
    "mapping",
    "refreshMinutes"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SourceConfig",
  "$defs": {
    "SourceType": {
      "type": "string",
      "enum": [
        "HTTPS_JSON",
        "MYSQL_VIEW",
        "CSV"
      ]
    },
    "SourceConfig": {
      "type": "object",
      "properties": {
        "endpoint": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "null"
            }
          ]
        },
        "connectionRef": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "viewRef": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "assetRef": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "FieldMapping": {
      "type": "object",
      "properties": {
        "region": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "measure": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "denominator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "region",
        "date",
        "measure",
        "value"
      ],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "HTTPS_JSON"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "config": {
            "required": [
              "endpoint"
            ],
            "properties": {
              "endpoint": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "MYSQL_VIEW"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "config": {
            "required": [
              "connectionRef",
              "viewRef"
            ],
            "properties": {
              "connectionRef": {
                "type": "string",
                "minLength": 1
              },
              "viewRef": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "CSV"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "config": {
            "required": [
              "assetRef"
            ],
            "properties": {
              "assetRef": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  ]
}
