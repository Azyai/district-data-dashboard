{
  "name": "district-dashboard-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24.22.0 <25",
    "pnpm": ">=12.16.1 <13"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint src vite.config.ts",
    "typecheck": "tsc --noEmit",
    "contracts:generate": "openapi-typescript ../contracts/openapi.json -o src/api/generated/openapi.ts",
    "contracts:check": "openapi-typescript ../contracts/openapi.json -o src/api/generated/openapi.ts --check",
    "test:e2e": "node tests/browser.mjs",
    "test:e2e:admin": "node tests/admin-browser.mjs",
    "test:e2e:topics": "node tests/topics-browser.mjs",
    "test:e2e:areas": "node tests/area-transitions.mjs",
    "test:e2e:voice": "node tests/voice-orb-browser.mjs",
    "test:intent": "node --test tests/cockpit-intent.mjs"
  },
  "dependencies": {
    "@ant-design/cssinjs": "2.2.0",
    "@tanstack/react-query": "5.108.2",
    "antd": "6.7.1",
    "echarts": "6.1.0",
    "maplibre-gl": "5.24.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.6",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/geojson": "7946.0.16",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "gltfpack": "1.3.0",
    "openapi-typescript": "7.13.0",
    "playwright": "1.65.1",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8"
  }
}
